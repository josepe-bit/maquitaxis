# ====================================================================
# MAQUITAXIS - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa con tus credenciales reales
# ====================================================================

# --------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL SERVIDOR MCP DE SUPABASE (Model Context Protocol)
# --------------------------------------------------------------------
# ID de referencia del proyecto en Supabase Cloud (ej: 'xyz123abc456')
SUPABASE_PROJECT_REF=your-supabase-project-ref

# URL Base del proyecto Supabase (Cloud: https://your-project-ref.supabase.co | Local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Clave pública anónima (Anon Key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave de servicio secreta (Service Role Key - Solo operaciones administrativas / MCP)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token de Acceso Personal (PAT) para el servidor MCP oficial de Supabase (@supabase/mcp-server-supabase)
# Generar en: Supabase Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# URL de conexión directa PostgreSQL para MCP Postgres
# Local CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud Pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --------------------------------------------------------------------
# 2. CONFIGURACIÓN PANEL WEB ADMIN (Vite / React)
# --------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------------------------------------------------------
# 3. CONFIGURACIÓN APP MÓVIL (Expo / React Native)
# --------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Configuración del Motor GPS Móvil (Valores recomendados)
EXPO_PUBLIC_GPS_MIN_DISTANCE_METERS=15
EXPO_PUBLIC_GPS_MAX_INTERVAL_SECONDS=30
EXPO_PUBLIC_GPS_MIN_ACCURACY_METERS=30
